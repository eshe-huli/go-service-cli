package httpapi

import (
 "context"
 "net/http"
 "{{.Project.GoModule}}/internal/{{.Module.Name}}/internal/app"
 "{{.Project.GoModule}}/internal/platform/httpx"
)
{{range endpoints .Module}}
type {{export .Name}}Runner interface {
 Execute(context.Context, app.{{export .Name}}Input) (app.{{export .Name}}Output, error)
}
{{end}}
type Handlers struct {
 {{range endpoints .Module}}{{export .Name}} {{export .Name}}Runner
 {{end}}
}
func Register(mux *http.ServeMux, h Handlers) {
 {{range endpoints .Module}}mux.HandleFunc("{{.Endpoint.Method}} {{.Endpoint.Path}}", func(w http.ResponseWriter, r *http.Request) {
  var input app.{{export .Name}}Input
  {{if eq .Kind "command"}}
  if err := httpx.DecodeJSON(w, r, &input{{range .Input}}, "{{.Name}}"{{end}}); err != nil { httpx.Failure(w, err); return }
  {{else}}
  q, err := httpx.Query(r{{range queryfields .}}, "{{.Name}}"{{end}})
  if err != nil { httpx.Failure(w, err); return }
  _ = q
  {{bindquery .}}
  {{end}}
  if err := input.Validate(); err != nil { httpx.Failure(w, err); return }
  output, err := h.{{export .Name}}.Execute(r.Context(), input)
  if err != nil { httpx.Failure(w, err); return }
  httpx.JSON(w, http.StatusOK, output)
 })
 {{end}}
}
